@model IEnumerable<CobrancaWeb.LegacyMvc.Controllers.ContratoLegadoModel>

@{
    ViewBag.Title = "CobrançaWeb — Módulo Legado (ASP.NET MVC 5)";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <!-- Estilo Clássico Bootstrap 3 / Legado -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" />
    <style>
        .painel-cobranca { margin-top: 20px; border-radius: 4px; }
        .tabela-dados th { background-color: #2c3e50; color: #ffffff; }
        .badge-atraso { background-color: #d9534f; font-size: 11px; }
        .modal-header-negociacao { background-color: #337ab7; color: white; }
    </style>
</head>
<body>
    <div class="container">
        <div class="page-header">
            <h2><span class="glyphicon glyphicon-usd"></span> CobrançaWeb <small>Módulo Operacional Legado (ASP.NET MVC + ADO.NET)</small></h2>
            <p class="text-muted"><em>Interface legada para consulta de inadimplentes e formalização de acordos.</em></p>
        </div>

        <!-- Formulário de Filtro Clássico -->
        <div class="panel panel-default painel-cobranca">
            <div class="panel-heading"><strong>Filtro de Localização de Devedores</strong></div>
            <div class="panel-body">
                <form method="get" action="/ConsultaCobranca/Index" class="form-inline">
                    <div class="form-group">
                        <label for="termoBusca">Buscar por Nome, CPF ou Nº Contrato:</label>
                        <input type="text" id="termoBusca" name="termoBusca" class="form-control" style="width: 350px;" placeholder="Ex: Maria Silva ou 52998224725" value="@Request["termoBusca"]" />
                    </div>
                    <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-search"></span> Localizar</button>
                    <a href="/ConsultaCobranca/Index" class="btn btn-default">Limpar</a>
                </form>
            </div>
        </div>

        <!-- Tabela de Contratos em Atraso -->
        <div class="panel panel-primary">
            <div class="panel-heading"><strong>Carteira de Contratos Inadimplentes (Em Aberto)</strong></div>
            <div class="panel-body">
                <table class="table table-striped table-bordered table-hover tabela-dados" id="tabelaContratos">
                    <thead>
                        <tr>
                            <th>Contrato</th>
                            <th>Devedor</th>
                            <th>CPF / CNPJ</th>
                            <th>Telefone</th>
                            <th>Vencimento</th>
                            <th>Dias Atraso</th>
                            <th>Valor Original</th>
                            <th>Valor Atualizado (c/ Juros)</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.NumeroContrato</strong></td>
                                    <td>@item.NomeDevedor</td>
                                    <td>@item.Documento</td>
                                    <td>@(item.Telefone ?? "Não informado")</td>
                                    <td>@item.Vencimento.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge badge-atraso">@item.DiasAtraso dias</span></td>
                                    <td>@item.ValorOriginal.ToString("C")</td>
                                    <td><strong class="text-danger">@item.ValorAtualizado.ToString("C")</strong></td>
                                    <td>
                                        <button type="button" class="btn btn-xs btn-success btn-abrir-acordo"
                                                data-id="@item.ContratoId"
                                                data-numero="@item.NumeroContrato"
                                                data-devedor="@item.NomeDevedor"
                                                data-valor="@item.ValorAtualizado"
                                                data-dias="@item.DiasAtraso">
                                            <span class="glyphicon glyphicon-pencil"></span> Negociar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted">Nenhum contrato em atraso localizado para os filtros informados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Clássico de Negociação de Acordo -->
    <div class="modal fade" id="modalNegociacao" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header modal-header-negociacao">
                    <button type="button" class="close" data-dismiss="modal" style="color:white;">&times;</button>
                    <h4 class="modal-title"><span class="glyphicon glyphicon-briefcase"></span> Proposta de Acordo Extrajudicial</h4>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="txtContratoId" />
                    
                    <div class="alert alert-info">
                        <strong>Contrato:</strong> <span id="lblNumeroContrato"></span> | 
                        <strong>Devedor:</strong> <span id="lblNomeDevedor"></span><br />
                        <strong>Dias em Atraso:</strong> <span id="lblDiasAtraso"></span> | 
                        <strong>Dívida Corrigida:</strong> <span id="lblValorAtualizado" class="text-danger font-weight-bold"></span>
                    </div>

                    <div id="alertaErroNegociacao" class="alert alert-danger" style="display:none;"></div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label for="txtDesconto">Desconto Oferecido (%):</label>
                            <input type="number" id="txtDesconto" class="form-control" min="0" max="100" value="10" />
                            <small class="text-muted">Aviso: Máximo de 30% para atraso inferior a 90 dias.</small>
                        </div>
                        <div class="col-md-6 form-group">
                            <label for="cboParcelas">Quantidade de Parcelas:</label>
                            <select id="cboParcelas" class="form-control">
                                <option value="1">1x (À vista)</option>
                                <option value="2">2x</option>
                                <option value="3" selected>3x</option>
                                <option value="4">4x</option>
                                <option value="6">6x</option>
                                <option value="12">12x</option>
                            </select>
                        </div>
                    </div>

                    <button type="button" id="btnSimularAcordo" class="btn btn-default btn-block">
                        <span class="glyphicon glyphicon-refresh"></span> Calcular Proposta
                    </button>

                    <!-- Quadro de Simulação -->
                    <div id="quadroResultadoSimulacao" style="display:none; margin-top: 15px;">
                        <div class="well">
                            <p><strong>Valor Total Acordado:</strong> <span id="lblTotalAcordo" class="text-success lead"></span></p>
                            <p><strong>Valor de Cada Parcela:</strong> <span id="lblValorParcela" class="lead"></span></p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                    <button type="button" id="btnEfetivarAcordo" class="btn btn-success" disabled>
                        <span class="glyphicon glyphicon-ok"></span> Confirmar e Firmar Acordo
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts Legados -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
    <script src="/Scripts/legacy-cobranca.js"></script>
</body>
</html>
